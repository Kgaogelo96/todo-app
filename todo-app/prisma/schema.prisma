generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  dueDate     DateTime
  topic       String
  status      String   @default("TODO")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
